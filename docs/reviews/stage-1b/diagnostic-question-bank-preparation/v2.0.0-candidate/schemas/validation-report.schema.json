  "required": [
    "executedAtUtc",
    "status",
    "python",
    "jsonschema",
    "schemasChecked",
    "jsonDocumentsValidated",
    "counts",
    "negativeTests",
    "negativeTestsRejected",
    "selectionExecuted",
    "actualAttemptsCreated",
    "audioProductionOrHumanVerificationPerformed",
    "limitations"
  ],
  "additionalProperties": false
