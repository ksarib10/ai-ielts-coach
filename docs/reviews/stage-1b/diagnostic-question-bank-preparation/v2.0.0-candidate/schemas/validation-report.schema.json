    "selectionExecuted": {
      "const": false
    },
    "actualAttemptsCreated": {
      "const": 0
    },
    "audioProductionOrHumanVerificationPerformed": {
      "const": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "integrity": {
      "type": "object",
      "properties": {
        "outputPayloadHashes": {
          "type": "integer",
          "minimum": 0
