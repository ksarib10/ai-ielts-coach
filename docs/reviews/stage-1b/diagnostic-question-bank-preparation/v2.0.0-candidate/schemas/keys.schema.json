{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiielts.invalid/candidate-schemas/keys.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "bankVersion": {
      "const": "diagnostic-v1-bank.2.0.0-candidate"
    },
    "status": {
      "const": "CANDIDATE_NOT_APPROVED"
    },
    "scoringPolicyVersion": {
      "type": "string",
      "minLength": 1
    },
    "approvalStatus": {
      "const": "PENDING_HUMAN"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string",
            "minLength": 1
          },
          "formId": {
            "type": "string",
            "minLength": 1
          },
          "proposedCorrectOptionId": {
            "type": "string",
            "minLength": 1
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "distractorRationales": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "optionId": {
                  "type": "string",
                  "minLength": 1
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "optionId",
                "rationale"
              ],
              "additionalProperties": false
            },
            "minItems": 3,
            "maxItems": 3
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "sourceId",
                "locator",
                "quote"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "questionId",
          "formId",
          "proposedCorrectOptionId",
          "explanation",
          "distractorRationales",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 54,
      "maxItems": 54
    }
  },
  "required": [
    "schemaVersion",
    "bankVersion",
    "status",
    "scoringPolicyVersion",
    "approvalStatus",
    "entries"
  ],
  "additionalProperties": false
}
